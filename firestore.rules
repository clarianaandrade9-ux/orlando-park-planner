rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function member(tripId){ return signedIn() && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)); }
    function role(tripId){ return get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role; }
    match /trips/{tripId} {
      allow read: if member(tripId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if member(tripId) && role(tripId) == 'admin';
      match /members/{uid} { allow read: if member(tripId); allow write: if member(tripId) && role(tripId) == 'admin'; }
      match /{collection}/{docId} {
        allow read: if member(tripId);
        allow create, update: if member(tripId) && role(tripId) in ['admin','editor'];
        allow delete: if member(tripId) && role(tripId) == 'admin';
      }
    }
    match /catalog/{document=**} { allow read: if signedIn(); allow write: if false; }
  }
}
